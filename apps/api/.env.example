DATABASE_URL="file:./dev.db"

# Ruta raíz donde se crearán los workspaces de las tasks.
# Se usa una ruta corta para evitar problemas de rutas largas en Windows.
WORKSPACES_ROOT="./workspaces"

# Ruta donde se guardan los logs NDJSON del stream-json de Claude
LOGS_ROOT="./logs"

# Carpetas ADICIONALES donde buscar SKILL.md. Opcional y normalmente vacío:
# la carpeta propia del cockpit (SKILLS_ROOT) se escanea siempre y se crea sola.
# Úsalo solo si ya tienes skills en otro sitio, p.ej. "~/.claude/skills".
SKILLS_PATHS=""

# Dónde guarda el cockpit las skills que creas desde la UI.
# Por defecto ./skills, relativa al cwd de la API. No hace falta tocarlo.
# SKILLS_ROOT="./skills"

# Cómo se autentica el CLI en cada run:
#   subscription = usa tu login de claude.ai y consume del plan (por defecto)
#   api_key      = inyecta ANTHROPIC_API_KEY y se factura por API
# En modo subscription el runner BORRA la key del entorno del hijo: si está
# presente, el CLI le da precedencia sobre tu login y facturaría por API.
AUTH_MODE="subscription"

# API key de Anthropic. Solo se usa en AUTH_MODE=api_key y cuando relanzas a
# mano una run que se quedó sin cuota del plan.
ANTHROPIC_API_KEY="sk-ant-..."

# Puerto del API
PORT=3001

# Ruta al ejecutable de claude CLI. Normalmente "claude" si está en PATH.
CLAUDE_CLI="claude"

# Interfaz donde escucha la API. 127.0.0.1 = solo esta máquina.
# Cambiarlo a 0.0.0.0 expone el lanzador de agentes a toda la red local.
HOST="127.0.0.1"

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Timeout por run en milisegundos. 0 = sin límite.
RUN_TIMEOUT_MS=1800000

# Cuántos agentes pueden correr a la vez al arrancar. Se puede cambiar en
# caliente desde la cabecera de la app.
QUEUE_CONCURRENCY=2

# Limpieza de workspaces: edad mínima para tocarlos y cada cuántas horas barre
# (0 desactiva el barrido periódico; el de arranque siempre corre).
# Nunca borra cambios sin commitear ni copias de runs cuya tarea sigue abierta.
WORKSPACE_GC_DAYS=7
WORKSPACE_GC_INTERVAL_HOURS=6

# Modelo que propone las tareas iniciales al crear un proyecto, y su timeout.
# Solo lee y devuelve JSON, así que no hace falta el modelo más caro.
PLANNER_MODEL="claude-sonnet-5"
PLAN_TIMEOUT_MS=300000

# Copias de la base de datos. Se hace una al arrancar la API y se conservan las
# BACKUP_KEEP últimas. 0 desactiva la copia automática; el botón de descarga
# del dashboard sigue funcionando igual.
BACKUPS_ROOT="./backups"
BACKUP_KEEP=5
