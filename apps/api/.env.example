DATABASE_URL="file:./dev.db"

# Ruta raíz donde se crearán los workspaces de las tasks.
# Se usa una ruta corta para evitar problemas de rutas largas en Windows.
WORKSPACES_ROOT="./workspaces"

# Ruta donde se guardan los logs NDJSON del stream-json de Claude
LOGS_ROOT="./logs"

# Rutas a escanear para descubrir SKILL.md
# Separadas por coma. Rutas absolutas o relativas al cwd de la API.
# Tanto barras / como \ funcionan en Windows.
SKILLS_PATHS="./skills"

# API key de Anthropic (el runner la inyecta a claude CLI)
ANTHROPIC_API_KEY="sk-ant-..."

# Puerto del API
PORT=3001

# Ruta al ejecutable de claude CLI. Normalmente "claude" si está en PATH.
CLAUDE_CLI="claude"
