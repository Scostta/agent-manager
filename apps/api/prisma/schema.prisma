// Claude Cockpit - schema de datos
// Uso personal local con SQLite. Migrar a Postgres es cambiar el provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                 String    @id @default(cuid())
  name               String
  description        String?
  repoPath           String    // ruta absoluta al repo / carpeta del proyecto
  workspaceStrategy  String    @default("worktree") // "worktree" | "copy"
  claudeMdId         String?   @unique
  claudeMd           ClaudeMd? @relation(fields: [claudeMdId], references: [id])
  tasks              Task[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Agent {
  id            String       @id @default(cuid())
  name          String
  role          String
  model         String
  systemPrompt  String
  maxBudgetUsd  Float?
  status        String       @default("idle")
  skills        AgentSkill[]
  tasks         Task[]
  runs          TaskRun[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Skill {
  id           String       @id @default(cuid())
  name         String       @unique
  description  String
  filePath     String
  contentHash  String
  scope        String
  tags         String
  agents       AgentSkill[]
  updatedAt    DateTime     @updatedAt
}

model AgentSkill {
  agentId String
  skillId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([agentId, skillId])
}

model Task {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  description      String
  status           String    @default("todo")
  priority         Int       @default(0)
  assignedAgentId  String?
  assignedAgent    Agent?    @relation(fields: [assignedAgentId], references: [id])
  requiredSkillIds String    @default("[]")
  dependsOn        String    @default("[]")
  position         Int
  runs             TaskRun[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, status])
}

model TaskRun {
  id              String    @id @default(cuid())
  taskId          String
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agentId         String
  agent           Agent     @relation(fields: [agentId], references: [id])
  status          String    // queued | running | succeeded | failed | cancelled
  workspacePath   String
  branchName      String?   // null si la estrategia es 'copy'
  inputTokens     Int       @default(0)
  outputTokens    Int       @default(0)
  cacheReadTokens Int       @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd         Float     @default(0)
  logPath         String
  resultSummary   String?
  pid             Int?
  // Por qué falló: "rate_limit" (se agotó el plan y espera decisión),
  // "rate_limit_waiting" (el usuario eligió esperar al reset), "error".
  failureKind     String?
  // Cuándo vuelve a haber cuota, leído del mensaje del CLI.
  rateLimitResetAt DateTime?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  @@index([taskId])
  @@index([status])
}

model ClaudeMd {
  id        String   @id @default(cuid())
  scope     String
  content   String
  filePath  String?
  project   Project?
  updatedAt DateTime @updatedAt
}
