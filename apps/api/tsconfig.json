{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "prisma/**/*"],
  // Los tests se typechequean con `pnpm typecheck`, pero no tienen por qué
  // acabar en dist: el build es solo lo que corre en producción.
  "exclude": ["src/**/*.test.ts"]
}
